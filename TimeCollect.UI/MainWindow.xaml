<Window x:Class="TimeCollect.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeCollect.UI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Title="BPG TimeCollect" Height="550" Width="600">
    <!-- The TabControl acts as your upper navigation bar -->
    <TabControl Background="#F8F9FA">

        <!-- TAB 1: Primary Execution Workspace -->
        <TabItem Header="Execution">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button x:Name="btnRun" Grid.Row="0" Content="Run TimeCollect" 
                        Height="40" Width="200" Margin="0,0,0,20"
                        Click="BtnRun_Click" 
                        FontWeight="Bold" FontSize="14"
                        HorizontalAlignment="Center"/>

                <!-- The Live Log Console -->
                <TextBox x:Name="txtLog" Grid.Row="1" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" 
                         Background="#1E1E1E" Foreground="#D4D4D4" 
                         FontFamily="Consolas" FontSize="12" 
                         Padding="10"
                         BorderThickness="0"/>
            </Grid>
        </TabItem>

        <!-- TAB 2: Parametric Settings -->
        <TabItem Header="Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reduced RowDefinitions from 8 to 6 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Output Directory 2026:" Margin="0,0,10,10"/>
                    <TextBox x:Name="txtOutputDirectory" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Project Spreadsheet:" Margin="0,0,10,10"/>
                    <TextBox x:Name="txtProjectSpreadsheet" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Project Range:" Margin="0,0,10,10"/>
                    <TextBox x:Name="txtProjectRange" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Employees Spreadsheet:" Margin="0,0,10,10"/>
                    <TextBox x:Name="txtEmployeesSpreadsheet" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Sheet Names:" Margin="0,0,10,10"/>
                    <TextBox x:Name="txtSheetNames" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

                    <!-- New DatePicker Component -->
                    <!-- New DatePicker Component with Event Binding -->
                    <Label Grid.Row="5" Grid.Column="0" Content="Start Date:" Margin="0,0,10,10"/>
                    <DatePicker x:Name="dpStartDate" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" 
                                SelectedDateFormat="Short" 
                                SelectedDateChanged="DpStartDate_SelectedDateChanged" />
                </Grid>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Window>
